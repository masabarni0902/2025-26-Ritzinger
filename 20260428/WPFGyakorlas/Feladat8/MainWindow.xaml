<Window x:Class="Feladat8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Feladat8"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Margin="16">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="txtTermekNev"
                 Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="txtAr"
                 Margin="0,0,8,0"/>
            <Button  Grid.Column="2" Content="Hozzáad"
                 Click="TermekHozzaad_Click"/>
        </Grid>

        <DataGrid x:Name="dgTermekek"
              Height="200"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Terméknév"
                Binding="{Binding Nev}" Width="*"/>
                <DataGridTextColumn Header="Ár (Ft)"
                Binding="{Binding Ar}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Kijelölt törlése"
            Click="TermekTorol_Click"
            HorizontalAlignment="Right"/>
    </StackPanel>
</Window>
