<Window x:Class="WPF_Login.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Login"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <CheckBox Content="Megjegyzem a belépést" HorizontalAlignment="Left" Margin="212,227,0,0" VerticalAlignment="Top"/>
        <Image Source="/images.png" HorizontalAlignment="Left" Height="100" Margin="55,106,0,0" VerticalAlignment="Top" Width="100"/>
        <Button Content="BEJELENTKEZÉS" HorizontalAlignment="Left" Margin="532,162,0,0" VerticalAlignment="Top" Background="#FF3AFF00" FontSize="18" Click="Button_Click"/>
        <Button Content="MÉGSEM" HorizontalAlignment="Left" Margin="532,217,0,0" VerticalAlignment="Top" Height="25" Width="128" FontSize="18" Click="Button_Click_1"/>
        <Label  Content="Jelszó:" HorizontalAlignment="Left" Margin="212,156,0,0" VerticalAlignment="Top"/>
        <Label  Content="Felhasználónév:" HorizontalAlignment="Left" Margin="212,88,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.603,0.438"/>
        <TextBox x:Name="txtFelhasznalo" HorizontalAlignment="Left" Margin="218,119,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="124" RenderTransformOrigin="0.5,0.5" Height="24">
            <TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.502"/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBox.RenderTransform>
        </TextBox>
        <PasswordBox x:Name="txtJelszo" HorizontalAlignment="Left" Margin="212,182,0,0" VerticalAlignment="Top" Width="120"/>
        <Label x:Name="fejlecText" Content="ÜDVÖZÖLEK A RENDSZERÜNKBEN" HorizontalAlignment="Left" Margin="285,10,0,0" VerticalAlignment="Top" Width="250" Foreground="#FF0430A1" HorizontalContentAlignment="Center"/>

    </Grid>
</Window>
